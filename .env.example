# Public (safe in the browser). Same project as crawler_pc / crawler_mobile.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server only. Required for admin add/remove/change role. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Google service account JSON (same secret as crawler PC Edge Function).
# Used to read catalog sheets. Never expose to the client.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Sheets Catalog ID (bắt buộc nếu dùng tính năng duyệt danh mục truyện)
# Lấy từ URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_CATALOG_SHEET_ID=your-google-sheet-id

# Optional overrides (mặc định là 'Danh sách truyện'!A2:M)
# GOOGLE_CATALOG_SHEET_RANGE='Danh sách truyện'!A2:M

# After deploy, add these Redirect URLs in Supabase Auth:
# http://localhost:3000/auth/callback
# https://<your-vercel-domain>/auth/callback
